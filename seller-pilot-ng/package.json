{
  "name": "sellerpilot-ng",
  "version": "1.0.0",
  "private": true,
  "description": "SellerPilot NG - an AI co-pilot for Instagram/WhatsApp sellers that turns a chat message into a product listing, a PayPal checkout link, invoices, buyer replies and a sales dashboard.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "test": "tsx --test server/test/*.test.ts",
    "smoke:paypal": "tsx scripts/paypal-smoke.ts"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@paypal/agent-toolkit": "^1.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
